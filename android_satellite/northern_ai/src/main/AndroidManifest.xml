<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ package visibility for the installed speech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
    <!-- Internet already used by the local server and opt-in HTTPS Worker; speech requires no new permission. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="${northernAiAppLabel}"
        android:icon="@drawable/northern_circuit_company_logo"
        android:roundIcon="@drawable/northern_circuit_company_logo"
        android:theme="@style/NorthernAiTheme"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/loopback_security"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity android:name=".AssistantActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
